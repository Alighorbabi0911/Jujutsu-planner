          <body>
          <main>
          <header><div class="kan">呪</div><h1>دفتر نفرین‌شکن</h1><p class="sub" id="now"></p></header>
          <button id="big">✦ کارهاتو به ما بسپارید<small>بنویس و ما یادآوری می‌کنیم</small></button>
          <h3>پروژه‌ها</h3>
          <div id="grid"></div>
          <p class="note">آلارم‌ها با سیستم گوشی تنظیم می‌شن و با صفحه‌ی قفل یا برنامه‌ی بسته هم زنگ می‌خورن.</p>
          </main>

          <div class="sheet" id="sheet"><div class="panel">
          <h3>کارت رو بنویس</h3>
          <textarea id="txt" placeholder="مثلاً: ساعت ۱۳:۰۰ قرار دارم"></textarea>
          <div class="err" id="err"></div>
          <label class="sw">هر روز تکرار بشه<input type="checkbox" id="rep"></label>
          <h3 style="margin-top:14px">تنظیمات آلارم</h3>
          <select id="lead"><option value="0">دقیقاً سر وقت</option><option value="5">۵ دقیقه قبل</option><option value="10">۱۰ دقیقه قبل</option><option value="30">۳۰ دقیقه قبل</option></select>
          <label class="sw">صدای آلارم<input type="checkbox" id="snd" checked></label>
          <label class="sw">ویبره<input type="checkbox" id="vib" checked></label>
          <label class="sw">نوتیفیکیشن<input type="checkbox" id="ntf" checked></label>
          <button class="s" id="perm">فعال‌سازی اجازه‌ی نوتیف</button>
          <button class="s" id="test">تست آلارم</button>
          <button class="p" id="save">ثبت کار</button>
          <button class="s" id="close" style="width:100%">بستن</button>
          </div></div>

          <div id="alert"><div><div class="k">呪</div><h2>یادت نره! ⚔️</h2><p id="atxt"></p><button id="ok">باشه، رفتم</button></div></div>

          <script>
          var $=function(i){return document.getElementById(i)};
          var tasks=[],cfg={lead:"0",snd:true,vib:true,ntf:true};
          try{tasks=JSON.parse(localStorage.getItem("jt")||"[]");cfg=Object.assign(cfg,JSON.parse(localStorage.getItem("jc")||"{}"))}catch(e){}
          function save(){try{localStorage.setItem("jt",JSON.stringify(tasks));localStorage.setItem("jc",JSON.stringify(cfg))}catch(e){}}
          var P="۰۱۲۳۴۵۶۷۸۹";
          function fa(s){return String(s).replace(/\d/g,function(d){return P[d]})}
          function en(s){return s.replace(/[۰-۹]/g,function(d){return P.indexOf(d)}).replace(/[٠-٩]/g,function(d){return d.charCodeAt(0)-1632})}
          function pad(n){return String(n).padStart(2,"0")}
          function parse(t){
           var s=en(t),m=s.match(/(\d{1,2})\s*[:٫.]\s*(\d{2})/),h,mi;
           if(m){h=+m[1];mi=+m[2]}else{m=s.match(/ساعت\s*(\d{1,2})/);if(!m)return null;h=+m[1];mi=0}
           if(h>23||mi>59)return null;
           var title=t.replace(/ساعت\s*[\d۰-۹٠-٩]{1,2}(\s*[:٫.]\s*[\d۰-۹٠-٩]{2})?/,"").replace(/[\d۰-۹]{1,2}\s*[:٫.]\s*[\d۰-۹]{2}/,"").replace(/\s+/g," ").trim();
           return{h:h,mi:mi,title:title||t.trim()}
          }
          function nextAt(h,mi){var d=new Date();d.setHours(h,mi,0,0);if(d<=new Date())d.setDate(d.getDate()+1);return d.getTime()}
          function left(ms){var m=Math.round(ms/60000);if(m<1)return"الان";if(m<60)return fa(m)+" دقیقه دیگه";var h=Math.floor(m/60);return fa(h)+" ساعت و "+fa(m%60)+" دقیقه"}
          function render(){
           var g=$("grid");g.innerHTML="";
           if(!tasks.length){g.innerHTML='<div class="empty">هنوز پروژه‌ای نداری.<br>از دکمه‌ی بالا شروع کن.</div>';return}
           var now=Date.now();
           tasks.slice().sort(function(a,b){return a.at-b.at}).forEach(function(t){
            var d=document.createElement("div"),past=t.fired&&!t.rep,soon=!past&&t.at-now<3600000;
            d.className="sq"+(past?" past":soon?" soon":"");
            var tm=document.createElement("div");tm.className="tm";var dt=new Date(t.at);tm.textContent=fa(pad(dt.getHours())+":"+pad(dt.getMinutes()));
            var n=document.createElement("div");n.className="nm";n.textContent=t.title;
            var f=document.createElement("div");f.className="ft";
            var l=document.createElement("span");l.textContent=past?"انجام شد":left(t.at-now)+(t.rep?" · روزانه":"");
            var x=document.createElement("button");x.className="x";x.textContent="✕";
            x.onclick=function(){try{window.Android&&Android.cancel(String(t.id))}catch(e){}tasks=tasks.filter(function(q){return q.id!==t.id});save();render()};
            f.append(l,x);d.append(tm,n,f);g.appendChild(d);
           });
          }
          function openSheet(){$("lead").value=cfg.lead;$("snd").checked=cfg.snd;$("vib").checked=cfg.vib;$("ntf").checked=cfg.ntf;$("err").textContent="";$("sheet").style.display="flex";setTimeout(function(){$("txt").focus()},50)}
          $("big").onclick=openSheet;
          $("close").onclick=function(){$("sheet").style.display="none"};
          $("save").onclick=function(){
           var v=$("txt").value.trim();if(!v){$("err").textContent="چیزی بنویس.";return}
           var p=parse(v);if(!p){$("err").textContent="ساعت رو هم بنویس، مثلاً «ساعت ۱۳:۰۰».";return}
           cfg={lead:$("lead").value,snd:$("snd").checked,vib:$("vib").checked,ntf:$("ntf").checked};
           tasks.push({id:Date.now(),title:p.title,at:nextAt(p.h,p.mi),h:p.h,mi:p.mi,rep:$("rep").checked,lead:+cfg.lead,snd:cfg.snd,vib:cfg.vib,ntf:cfg.ntf,fired:false});
           sync(tasks[tasks.length-1]);save();$("txt").value="";$("rep").checked=false;$("sheet").style.display="none";render();
          };
          var ctx,loop;
          function ac(){try{ctx=ctx||new (window.AudioContext||window.webkitAudioContext)();if(ctx.state==="suspended")ctx.resume()}catch(e){}return ctx}
          function tone(){var c=ac();if(!c)return;[0,.3,.6].forEach(function(s){var o=c.createOscillator(),g=c.createGain();o.type="square";o.frequency.value=s?990:740;o.connect(g);g.connect(c.destination);g.gain.setValueAtTime(.15,c.currentTime+s);g.gain.exponentialRampToValueAtTime(.001,c.currentTime+s+.25);o.start(c.currentTime+s);o.stop(c.currentTime+s+.26)})}
          function ring(t){
           $("atxt").textContent=t.title;$("alert").style.display="flex";
           if(t.snd){tone();clearInterval(loop);loop=setInterval(tone,1500)}
           if(t.vib){try{navigator.vibrate&&navigator.vibrate([400,200,400,200,400])}catch(e){}}
           if(t.ntf){try{if(window.Notification&&Notification.permission==="granted")new Notification("یادت نره ⚔️",{body:t.title,requireInteraction:true})}catch(e){}}
          }
          $("ok").onclick=function(){$("alert").style.display="none";clearInterval(loop);try{window.Android&&Android.stop()}catch(e){}};
          $("perm").onclick=function(){try{Notification.requestPermission().then(function(r){$("perm").textContent=r==="granted"?"نوتیف فعال شد ✓":"اجازه داده نشد"})}catch(e){$("perm").textContent="این مرورگر نوتیف رو پشتیبانی نمی‌کنه"}};
          $("test").onclick=function(){ring({title:"این یه تست آلارمه",snd:$("snd").checked,vib:$("vib").checked,ntf:$("ntf").checked})};
          function tick(){
           var n=Date.now(),d=new Date();$("now").textContent="الان ساعت "+fa(pad(d.getHours())+":"+pad(d.getMinutes()));
           var ch=false;
           tasks.forEach(function(t){
            if(!t.fired&&n>=t.at-t.lead*60000){
             t.fired=true;ch=true;if(n-(t.at-t.lead*60000)<6*3600000)ring(window.Android?Object.assign({},t,{snd:false,vib:false,ntf:false}):t);
             if(t.rep){t.at=nextAt(t.h,t.mi);t.fired=false;sync(t)}
            }
           });
           if(ch)save();render();
          }
          function sync(t){try{if(window.Android&&!t.fired)Android.schedule(String(t.id),String(t.at-t.lead*60000),t.title,!!t.rep)}catch(e){}}
          tasks.forEach(sync);
          tick();setInterval(tick,5000);
          </script>
          </body>
